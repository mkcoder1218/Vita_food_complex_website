{
  "name": "vita-food-complex",
  "private": true,
  "scripts": {
    "dev": "node init && turbo run dev",
    "dev:frontend": "node init && turbo run dev --filter=frontend",
    "dev:admin": "node init && turbo run dev --filter=admin",
    "dev:backend": "node init && turbo run dev --filter=backend",
    "build": "node init && turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "sharp": "^0.35.3",
    "turbo": "^2.8.20",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@swc/core",
      "bcrypt",
      "sharp",
      "unrs-resolver"
    ]
  }
}
