# Public frontend URL used for canonical links, sitemap, structured data and metadata.
NEXT_PUBLIC_SITE_URL=https://www.vitafoodcomplex.com

# Production API URL. Keep the existing production value used by the deployment.
NEXT_PUBLIC_API_URL=

# Add after Google Search Console gives you the HTML-tag verification token.
# Paste only the content value, not the whole <meta> tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
